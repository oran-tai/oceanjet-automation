# Bookaway API
BOOKAWAY_ENV=stage
BOOKAWAY_API_URL_PROD=https://www.bookaway.com/_api
BOOKAWAY_API_URL_STAGE=https://admin-stage.bookaway.com/_api
BOOKAWAY_USERNAME=your.email@bookaway.com
BOOKAWAY_PASSWORD=your_password_here
BOOKAWAY_BOT_IDENTIFIER=automation-bot@bookaway.com

# Polling
POLLING_INTERVAL_MS=30000

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_WEBHOOK_URL_2=

# RPA Agents — one per Windows VM / PRIME session, comma-separated, optional name=
# The orchestrator hands each free agent the next unclaimed booking.
# Example: RPA_AGENT_URLS=VM2=http://localhost:8080,VM1=http://10.122.2.27:8080
# Leave empty to use the single RPA_AGENT_URL below (default http://localhost:8080).
RPA_AGENT_URLS=
RPA_AGENT_URL=http://localhost:8080
RPA_AUTH_TOKEN=your_shared_secret_here

# Cloud dispatcher (several VMs): set the URL to let the Cloud Run service pick
# and claim bookings for every VM. Empty = this orchestrator picks for itself.
# Check from the VM: npx tsx tests/dispatcher-check.ts
DISPATCHER_URL=
# Name of this VM at the dispatcher and in Slack alerts (default: machine name)
DISPATCHER_AGENT_NAME=
# Key used to call the dispatcher (default: BQ_KEY_FILE, the oceanjet-events key)
DISPATCHER_KEY_FILE=

# Operator Mode: "mock" or "rpa"
OPERATOR_MODE=mock

# Pacing — random delay between bookings (ms) for human-like throughput
BOOKING_DELAY_MIN_MS=90000
BOOKING_DELAY_MAX_MS=180000
BOOKING_ERROR_COOLDOWN_MS=86400000

# BigQuery Events (optional — leave empty to disable)
BQ_PROJECT_ID=travelier-ai
BQ_KEY_FILE=

# Price check — PRIME Total Due x (1 - discount) must equal Bookaway's supplier cost
PRICE_CHECK_ENABLED=true
SUPPLIER_DISCOUNT_RATE=0.05

# Target a specific booking (optional — leave empty for continuous mode)
TARGET_BOOKING=
